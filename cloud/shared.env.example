# Set these in the hosting service environment. Never commit actual secrets.
APP_NAME=Nexus API
DATABASE_URL=postgresql+psycopg://USERNAME:URL_ENCODED_PASSWORD@DATABASE_HOST:5432/nexus?sslmode=require
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CORS_ORIGINS=http://localhost:5173
TICKETMASTER_API_KEY=
MEETUP_ACCESS_TOKEN=
EVENTS_SYNC_MINUTES=30
EVENTS_DAYS_AHEAD=30
EVENTS_RADIUS_KM=50
