# Copy to frontend/.env to point the app at a different backend (e.g. your deployed AWS URL).
VITE_API_URL=http://localhost:8000

# Google Maps JavaScript API key (https://console.cloud.google.com/google/maps-apis). Without it, the map uses free OpenStreetMap tiles via Leaflet.
VITE_GOOGLE_MAPS_API_KEY=
# Optional: a Map ID from the Google Cloud console. Defaults to Google's DEMO_MAP_ID.
VITE_GOOGLE_MAPS_MAP_ID=
