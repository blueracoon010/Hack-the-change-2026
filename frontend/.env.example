# Copy to frontend/.env to point the app at a different backend (e.g. your deployed AWS URL).
VITE_API_URL=http://localhost:8000
# Development only: defaults to true. Set false to test the normal login flow.
# Production builds always require authentication regardless of this setting.
VITE_DEV_AUTH_BYPASS=true

# Optional Google Maps key. Without it the map uses OpenStreetMap / Leaflet.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
