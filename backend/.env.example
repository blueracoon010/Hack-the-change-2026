# Copy to backend/.env and edit. Everything has a working default for local dev.
APP_NAME=Project Spark API

# SQLite by default. For Postgres: postgresql+psycopg://user:pass@host:5432/dbname (and pip install "psycopg[binary]")
# DATABASE_URL=sqlite:///./app.db

# CHANGE THIS before deploying anywhere. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MINUTES=1440

# Comma separated. file:// and null cover the packaged Electron app.
CORS_ORIGINS=http://localhost:5173,file://,null

# Optional: Calgary Open Data app token (raises rate limits). https://data.calgary.ca/profile/edit/developer_settings
CALGARY_APP_TOKEN=

# Events -> map (app/events/README.md). Leave a key blank to skip that source.
# Ticketmaster: free key at https://developer.ticketmaster.com (My Apps -> Consumer Key). 5000 calls/day.
TICKETMASTER_API_KEY=
# Meetup: OAuth access token for https://api.meetup.com/gql-ext (may need Meetup Pro, see README).
MEETUP_ACCESS_TOKEN=
EVENTS_CENTER_LAT=51.0447
EVENTS_CENTER_LON=-114.0719
EVENTS_RADIUS_KM=50
EVENTS_DAYS_AHEAD=30
EVENTS_SYNC_MINUTES=30
# Nominatim requires an identifying User-Agent. Add a team contact URL or email here if you have one.
GEOCODER_USER_AGENT=CodeTheChangeYYC-hackathon-events-map/0.1
